{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**",
      "sandbox/**",
      "!sandbox/dist/**",
      "scripts/**",
      "tests/**",
      "!tests/dist/**",
      "vite.config.ts",
      "playwright.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
