{
  "name": "vidro-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build --filter=@vidro/website...",
    "dev": "pnpm sandbox",
    "typecheck": "turbo run typecheck --filter=@vidro/website...",
    "test": "pnpm --filter vidropro build && pnpm --filter vidropro test --workers=2",
    "lint": "biome lint . --files-ignore-unknown=true && pnpm --filter vidropro lint",
    "format": "biome format --write . --files-ignore-unknown=true",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.1.12"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "24.0.0",
    "turbo": "2.8.16",
    "typescript": "5.9.2",
    "vitest": "5.0.1"
  }
}
